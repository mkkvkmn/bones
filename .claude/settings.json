{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/env_vars.*.sh)",
      "Read(**/*.key)",
      "Read(~/.secrets/**)",
      "Edit(**/.env*)",
      "Edit(**/env_vars.*.sh)",
      "Edit(~/.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secret-reads.mjs\""
          }
        ]
      }
    ]
  }
}
