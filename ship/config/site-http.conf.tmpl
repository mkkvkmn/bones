# {{SITE}} before its certificate exists: content over plain HTTP (for testing by IP with a Host
# header, and for the first Let's Encrypt challenge). setup.sh switches to site-tls once the cert exists.
server {
    listen 80;
    server_name www.{{DOMAIN}};
    include /etc/nginx/ship/acme.inc;
    location / {
        return 301 http://{{DOMAIN}}$request_uri;
    }
}
server {
    listen 80;
    server_name {{DOMAIN}};
    root {{SITE_ROOT}}/current;
    include /etc/nginx/ship/acme.inc;
    include /etc/nginx/ship/{{SITE}}.headers;
    {{EXTRA_INCLUDE}}
    include /etc/nginx/ship/static.inc;
}
