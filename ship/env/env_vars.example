#!/bin/sh
# Server settings for bones/ship (OpenBSD). The template for env_vars.<env>.sh.
#
# Do not copy this by hand: from the sites repo root run
#   bash ../bones/ship/init-secrets.sh prod
# which creates ~/.secrets/<sites repo folder>/env_vars.prod.sh from this file, fills what it can
# and lists what is left. Never put the filled file in a repository.
#
# Sourced by bash with `set -u`. Single-quote secrets so $ and ! stay literal.
# Every key here must exist in your file: the scripts stop and name missing keys.

export DEPLOY_ENV="prod"

# --- Server ---
export SERVER_IP="YOUR_SERVER_IP"
# The one admin user that SSHes in (keys only) and uses doas. Root SSH is turned off once this
# user works. Lowercase letters, digits, _ or -.
export SERVER_USER="ship"
# Private key on this machine for SERVER_USER (and for root on the very first run).
export SSH_KEY_PATH="~/.ssh/id_ed25519"

# --- Alerts ---
# Monitor alerts and new-comment notifications go here.
export ADMIN_EMAIL="your-email@example.com"
# healthchecks.io ping URL (optional, recommended): https://hc-ping.com/<uuid>. Keep it secret.
export MONITOR_HEARTBEAT_URL=""

# --- Outgoing mail ---
# tem: relay through Scaleway Transactional Email (SMTP). none: no mail leaves the server
# (isso sends no notifications; alerts come only from healthchecks.io / UptimeRobot).
export MAIL_RELAY="tem"
# Sender address on a domain verified in Scaleway TEM, e.g. noreply@example.com.
export MAIL_FROM="CHANGE_ME_mail_from"
# TEM SMTP login: user = the Scaleway Project ID, password = an IAM API secret key limited to
# Transactional Email. Not needed with MAIL_RELAY=none.
export TEM_SMTP_USER="CHANGE_ME_tem_project_id"
export TEM_SMTP_PASSWORD='CHANGE_ME_tem_secret_key'

# --- isso comments ---
# Admin UI password (generated by init-secrets.sh; if you type your own, avoid %).
# To rotate: delete this line, re-run init-secrets.sh, then deploy-server.sh.
export ISSO_ADMIN_PASSWORD='CHANGE_ME_isso_admin_password'
# The admin UI (/admin) is only reachable from this IP. Empty = admin UI off.
export ISSO_ADMIN_ALLOW_IP=""

# --- Backups of the comment database ---
# age PUBLIC key (age1...). The private key stays on your machine / password manager.
# Create the key pair once, in Git Bash (install age first if needed: winget install FiloSottile.age):
#   age-keygen -o ~/age-sites-backup.key
# It prints "Public key: age1..." -> paste that here. Later: age-keygen -y ~/age-sites-backup.key
# prints it again. Store ~/age-sites-backup.key in your password manager too: without it no
# backup can be restored. Never put the private key (AGE-SECRET-KEY-...) in this file.
export BACKUP_AGE_PUBLIC_KEY="CHANGE_ME_age_public_key"
# Local copies (backup.sh). Outside every repo.
export BACKUP_DIR="~/.backups/sites"
export BACKUP_KEEP_DAYS="14"
# Private key used by restore.sh (optional; default: age-backup.key in the secrets folder,
# else ~/age-sites-backup.key).
export BACKUP_AGE_PRIVATE_KEY=""

# --- Releases ---
export KEEP_RELEASES="3"
